{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "projectSettings": {
    "framework": "nextjs"
  },
  "crons": [
    {
      "path": "/api/cron/monitor",
      "schedule": "0,15,30,45 * * * *"
    },
    {
      "path": "/api/cron/vrbo-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/guest-messages",
      "schedule": "*/5 * * * *"
    }
  ],
  "buildCommand": "pnpm run build",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && corepack enable && pnpm install",
  "devCommand": "pnpm run dev",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.rah-midland.com/:path*"
    }
  ]
}
