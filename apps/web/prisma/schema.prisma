// ============================================
// FINANCIAL LEDGER  (P1 objective 2)
// ============================================
// Added 2026-07-30. The accounting, invoicing, tax and inventory API routes
// served hardcoded in-memory arrays with no persistence of any kind, and no
// ledger schema existed -- see queue #26855. P5 (property-level P&L, tax-ready
// exports) is built on top of those routes, so it could only ever have graded
// fabricated numbers.
//
// Money is stored as INTEGER CENTS, not Float. The existing Expense.amount is a
// Float, which is wrong for money and is left alone here rather than migrated
// under a security-focused change; the API routes already speak *_cents, so
// cents is also the convention these endpoints expect.

/// Chart of accounts. `type` is one of asset|liability|equity|revenue|expense
/// and `normalSide` is debit|credit (strings, matching this schema's existing
/// convention of no enums).
model LedgerAccount {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  type       String
  normalSide String
  isActive   Boolean @default(true)

  lines JournalEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

/// One balanced double-entry transaction. The sum of its lines' debitCents must
/// equal the sum of their creditCents; this is enforced in the service layer
/// (a cross-row invariant Postgres cannot express as a simple CHECK).
/// Append-only in spirit: corrections post a reversing entry rather than edit.
model JournalEntry {
  id         String  @id @default(cuid())
  entryDate  DateTime
  memo       String
  reference  String?
  propertyId String?
  createdById String?

  /// Set when this entry reverses another; the reversed entry keeps its history.
  reversesId String? @unique

  postedAt DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  lines    JournalEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryDate])
  @@index([propertyId])
}

model JournalEntryLine {
  id             String @id @default(cuid())
  journalEntryId String
  accountId      String

  debitCents  Int @default(0)
  creditCents Int @default(0)

  /// Per-line property attribution is what makes property-level P&L possible
  /// without re-deriving it from memos.
  propertyId String?
  memo       String?

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([propertyId])
}

model Invoice {
  id          String @id @default(cuid())
  number      String @unique
  propertyId  String?
  guestId     String?
  /// The stay this invoice bills for, so an invoice can be re-derived from and
  /// reconciled against its booking rather than trusting client-sent figures.
  bookingId   String?
  status      String  @default("draft")
  issueDate   DateTime
  dueDate     DateTime?
  /// When it was actually settled -- needed to place the payment in the right
  /// accounting/tax period, which updatedAt cannot be trusted to represent.
  paidDate    DateTime?
  /// Stored alongside totalCents because tax is a reported figure, not one to
  /// re-derive later from a rate that may since have changed.
  subtotalCents Int   @default(0)
  taxCents      Int   @default(0)
  totalCents  Int     @default(0)
  paidCents   Int     @default(0)
  currency    String  @default("USD")
  notes       String?

  property Property?     @relation(fields: [propertyId], references: [id])
  lines    InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([propertyId])
}

model InvoiceLine {
  id            String @id @default(cuid())
  invoiceId     String
  description   String
  quantity      Int    @default(1)
  unitCents     Int
  totalCents    Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// A closed accounting/tax window. `lockedAt` is what makes a period immutable,
/// which P5 requires ("period locking").
model TaxPeriod {
  id          String    @id @default(cuid())
  name        String    @unique
  /// hot | sales | property | income | payroll
  type        String    @default("hot")
  description String?
  periodStart DateTime
  periodEnd   DateTime

  /// The liability for this period. Rate is stored as a fraction (0.06 = 6%).
  taxableRevenueCents Int   @default(0)
  taxRate             Float @default(0)
  taxDueCents         Int   @default(0)
  taxPaidCents        Int   @default(0)

  /// pending | filed | paid | overdue
  status   String    @default("pending")
  dueDate  DateTime?
  paidDate DateTime?

  /// lockedAt is what makes a closed period immutable (P5 "period locking").
  lockedAt    DateTime?
  lockedById  String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodStart, periodEnd])
}

model InventoryItem {
  id           String  @id @default(cuid())
  /// Optional: the API contract allows an item with no SKU. Postgres permits
  /// multiple NULLs in a unique column, so uniqueness still holds for real SKUs.
  sku          String? @unique
  name         String
  category     String  @default("other")
  unit         String  @default("each")
  /// parLevel is the reorder threshold; reorderQuantity is how much to buy.
  parLevel     Int     @default(0)
  reorderQuantity Int  @default(10)
  unitCostCents Int    @default(0)
  supplier     String?
  storageLocation String?
  lastCountedAt DateTime?
  propertyId   String?
  isActive     Boolean @default(true)

  property  Property?           @relation(fields: [propertyId], references: [id])
  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

/// Append-only stock ledger. `quantityDelta` is signed: negative is consumption.
model InventoryMovement {
  id         String @id @default(cuid())
  itemId     String
  propertyId String?
  quantityDelta Int
  reason     String
  reference  String?
  createdById String?

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([propertyId])
}

// ============================================
// OPERATIONAL NOTES  (P1, added 2026-07-30)
// ============================================

/// Free-form operational notes pinned to a property, booking or guest.
/// Replaces an in-memory array that discarded every note on cold start --
/// including things like "front gate code changed", which is exactly the sort
/// of note whose loss causes a real operational failure.
model Note {
  id         String  @id @default(cuid())
  /// general | property | booking | guest | maintenance
  type       String  @default("general")
  propertyId String?
  bookingId  String?
  guestId    String?
  title      String
  content    String
  pinned     Boolean @default(false)
  author     String  @default("system")
  /// JSON array of strings, matching this schema's existing convention for
  /// tag/amenity lists rather than introducing a relation for free text.
  tags       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([propertyId])
  @@index([bookingId])
  @@index([guestId])
  @@index([pinned])
}

/// A recurring third-party service the business pays for (Twilio, Vercel,
/// Supabase...). Distinct from PropertyServiceRate, which is what WE charge for
/// a service at a property; this is what we are charged to operate.
///
/// monthlyCost is DOLLARS as a float, matching the route contract this backs
/// and the rest of the money-as-dollars fields in this app. Cents-as-Int is the
/// better representation, but mixing the two silently is worse than either.
model ServiceSubscription {
  id           String    @id @default(cuid())
  /// Unique so re-POSTing a service updates it rather than creating a duplicate
  /// row -- the route this backs has always been an upsert by service name.
  service      String    @unique
  category     String
  description  String
  monthlyCost  Float     @default(0)
  billingCycle String    @default("monthly")
  status       String    @default("active")
  usageMetric  String?
  currentUsage Int?
  usageLimit   Int?
  notes        String?
  lastBilled   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, category])
}

/// A guest review, from any platform.
///
/// Replaces TWO separate in-memory arrays that both claimed to hold reviews and
/// disagreed with each other: id REV-002 was a 4-star Airbnb review from
/// "Sarah J." in one route and a 5-star Google review from "Sarah Johnson" in
/// the other, so posting a response through /respond left the list view
/// unchanged. One row, two response shapes rendered from it.
model Review {
  id         String  @id @default(cuid())
  propertyId String
  bookingId  String?
  guestId    String?
  /// Denormalised: reviews outlive the guest record, and platform imports often
  /// carry only a display name ("Sarah J.") with no matching Guest row.
  guestName  String
  platform   String  @default("direct")
  rating     Int
  comment    String

  response    String?
  respondedAt DateTime?

  /// Per-category sub-ratings (cleanliness, communication, ...) as JSON, matching
  /// how the rest of this schema stores optional structured blobs.
  categories String?

  /// Stay dates, where the source platform provides them.
  checkIn  DateTime?
  checkOut DateTime?

  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([platform])
  @@index([rating])
  @@index([respondedAt])
}

/// A registered thermostat.
///
/// Replaces an in-memory array that invented two devices, reported them
/// is_online: true, and answered every write with "Thermostat settings
/// updated". Nothing was ever sent anywhere. Someone setting a vacant Midland
/// property to 82F cooling to save money would have believed it took effect.
///
/// This table records which thermostats EXIST. It deliberately does not store a
/// current temperature or an online flag as truth: those are properties of a
/// device we cannot currently reach (the Tuya client in this repo speaks to
/// locks only), and a cached reading presented as live is the same lie in a
/// slower form. lastSeenAt/lastTempF are nullable and explicitly historical.
model Thermostat {
  id         String @id @default(cuid())
  propertyId String
  name       String @default("Main Thermostat")
  /// e.g. ecobee_smart_thermostat, nest_learning_thermostat
  deviceType String
  /// Vendor device identifier, once an integration exists to use it.
  deviceId   String? @unique

  /// Desired settings, as recorded here. NOT proof the device is running them.
  targetTempF     Int?
  mode            String  @default("off")
  fanMode         String  @default("auto")
  scheduleEnabled Boolean @default(false)
  /// Occupied/unoccupied setpoints as JSON.
  schedule        String?

  /// Last values actually observed from a device, and when. Null until an
  /// integration exists to observe anything.
  lastTempF     Int?
  lastHumidity  Int?
  lastSeenAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}
