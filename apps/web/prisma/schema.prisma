// Right at Home BnB - Prisma Schema
// Steven Palma | Midland, TX | 22 Properties
// Complete database schema for property management system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  authUid   String?  @unique
  name      String
  phone     String?
  avatarUrl String?
  role      String   @default("GUEST")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cleaningJobs     CleaningJob[]
  expenses         Expense[]
  approvedMsgs     Message[]          @relation("ApprovedBy")
  workerProfile    WorkerProfile?
  requestedWork    WorkOrder[]        @relation("WorkOrderRequestedBy")
  requestedActions ConciergeAction[]  @relation("ConciergeActionRequestedBy")
  approvedActions  ConciergeAction[]  @relation("ConciergeActionApprovedBy")
  accessGrants     AccessGrant[]
  assignedAlerts   OperationalAlert[] @relation("AlertAssignee")
  staffApplications StaffApplication[]

  // Performance indexes
  @@index([email])
  @@index([role])
  @@index([isActive]) // Filter active users
  @@index([role, isActive]) // Composite: active users by role
  @@index([createdAt]) // Sort by creation date
}

// ============================================
// PROPERTIES
// ============================================

model Property {
  id        String  @id @default(cuid())
  name      String
  address   String
  city      String  @default("Midland")
  state     String  @default("TX")
  zipCode   String?
  latitude  Float?
  longitude Float?

  // Property Details
  bedrooms     Int
  bathrooms    Float
  maxGuests    Int
  squareFeet   Int?
  propertyType String @default("HOUSE")

  // Amenities & Info (stored as JSON string)
  amenities     String?
  wifiNetwork   String?
  wifiPassword  String?
  parkingInfo   String?
  checkInInstr  String?
  checkOutInstr String?
  houseRules    String?

  // Cleaning
  cleaningChecklist String?

  // Pricing
  nightlyRate     Float
  cleaningFee     Float?
  securityDeposit Float?

  // External IDs
  airbnbId String?
  vrboId   String?

  /// Cross-system property key (#26898). The public catalogue publishes ids
  /// like `Humble-3106` and the lock hardware names its devices `garfield`,
  /// `castleford`, `lincolngreen` -- both use this scheme, not Property.id.
  /// Added rather than renaming Property.id, because a published id that
  /// Airbnb/VRBO configs may reference must not change underneath them.
  slug     String? @unique

  // Status
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings           Booking[]
  cleaningJobs       CleaningJob[]
  smartLock          SmartLock?
  expenses           Expense[]
  photos             PropertyPhoto[]
  vrboSync           VrboSync?
  workOrders         WorkOrder[]
  serviceRates       PropertyServiceRate[]
  checklistTemplates PropertyChecklistTemplate[]
  serviceSchedules   ServiceSchedule[]
  accessGrants       AccessGrant[]
  guestRequests      GuestRequest[]
  operationalAlerts  OperationalAlert[]

  // Financial ledger back-relations (P1 objective 2, added 2026-07-30)
  journalEntries     JournalEntry[]
  invoices           Invoice[]
  inventoryItems     InventoryItem[]
  reviews            Review[]
  thermostats        Thermostat[]

  // Performance indexes
  @@index([status])
  @@index([city])
  @@index([status, city]) // Composite: filter by status and city
  @@index([propertyType]) // Filter by property type
  @@index([bedrooms]) // Filter by bedroom count
  @@index([nightlyRate]) // Sort/filter by price
  @@index([airbnbId]) // Lookup by external ID
  @@index([vrboId]) // Lookup by external ID
  @@index([createdAt]) // Sort by creation date
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  caption    String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  /// Where the image was imported FROM (a VRBO CDN URL, say). Kept so a
  /// re-import can recognise a photo it already has; `url` is our own origin
  /// path and therefore cannot answer that question.
  sourceUrl  String?

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  blob     PropertyPhotoBlob?

  @@index([propertyId])
  @@index([propertyId, sourceUrl])
}

/// The bytes of a property photo, deliberately in their OWN table.
///
/// Several call sites load photos with `photos: true` (work orders, the cleaner
/// leaderboard, operations-service). A `Bytes` column on PropertyPhoto would
/// silently pull every image into memory on each of those queries. Splitting it
/// means the metadata stays cheap and the bytes are fetched only by the route
/// that serves them.
model PropertyPhotoBlob {
  id          String   @id @default(cuid())
  photoId     String   @unique
  data        Bytes
  contentType String
  byteSize    Int
  createdAt   DateTime @default(now())

  photo PropertyPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
}

// ============================================
// GUESTS & CRM
// ============================================

model Guest {
  id    String  @id @default(cuid())
  email String  @unique
  name  String
  phone String?

  // Source
  platform   String  @default("DIRECT")
  platformId String?

  // CRM Data
  firstStay  DateTime?
  lastStay   DateTime?
  totalStays Int       @default(0)
  totalSpent Float     @default(0)
  avgRating  Float?

  // Tags & Preferences (stored as JSON string)
  tags        String?
  notes       String?
  preferences String?

  // VIP Status
  isVip   Boolean @default(false)
  vipTier String?

  // Special Dates
  birthday    DateTime?
  anniversary DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings         Booking[]
  messages         Message[]
  conciergeQueries ConciergeQuery[]
  guestRequests    GuestRequest[]

  // Performance indexes
  @@index([email])
  @@index([isVip])
  @@index([platform]) // Filter by booking platform
  @@index([platform, platformId]) // Lookup by platform ID
  @@index([totalStays]) // Sort by stay count (loyalty)
  @@index([totalSpent]) // Sort by revenue (VIP identification)
  @@index([lastStay]) // Filter by recency
  @@index([isVip, totalSpent]) // Composite: VIP ranking
  @@index([createdAt]) // Sort by registration date
  @@index([birthday]) // Birthday campaign targeting
}

// ============================================
// BOOKINGS
// ============================================

model Booking {
  id         String @id @default(cuid())
  propertyId String
  guestId    String

  // Dates
  checkIn  DateTime
  checkOut DateTime

  // Details
  guestCount  Int     @default(1)
  platform    String  @default("DIRECT")
  confirmCode String?

  // Pricing
  nightlyRate Float
  totalNights Int
  subtotal    Float
  cleaningFee Float?
  serviceFee  Float?
  taxes       Float?
  totalPrice  Float

  /// The reference stamped onto the PayPal order at checkout (RAH-xxxx), kept
  /// in its OWN column. It used to live in confirmCode, which the capture route
  /// then overwrote with the transaction id -- destroying the only proof that a
  /// given PayPal order belonged to this booking, and breaking legitimate
  /// retries. confirmCode is also read by the invoice path, so it could not
  /// simply be repurposed.
  paypalOrderRef String?
  /// PayPal capture id, so a repeated capture of the SAME transaction can be
  /// recognised and answered idempotently instead of charging again.
  paypalCaptureId String?

  // Access
  accessCode    String?
  codeExpiresAt DateTime?

  // Status
  status        String  @default("CONFIRMED")
  specialReqs   String?
  internalNotes String?

  /// The reservation id as the channel knows it (a VRBO reservationId, say).
  ///
  /// This is what makes channel webhooks idempotent. Firestore got that for
  /// free -- `collection('bookings').doc(reservationId).set(..., {merge:true})`
  /// cannot create a second document -- and a port that inserted instead would
  /// accumulate a duplicate booking on every webhook retry, which channels do
  /// routinely. Unique per platform, and nullable so direct bookings (which
  /// have no external id) are unaffected: Postgres does not conflict NULLs.
  externalRef   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property      Property           @relation(fields: [propertyId], references: [id])
  guest         Guest              @relation(fields: [guestId], references: [id])
  cleaningJob   CleaningJob?
  messages      Message[]
  workOrders    WorkOrder[]
  accessGrants  AccessGrant[]
  guestRequests GuestRequest[]
  alerts        OperationalAlert[]

  // Performance indexes
  @@index([propertyId])
  @@index([guestId])
  @@index([checkIn])
  @@index([checkOut])
  @@index([status])
  @@index([propertyId, checkIn]) // Composite: property availability queries
  @@index([propertyId, status]) // Composite: property bookings by status
  @@index([propertyId, checkIn, checkOut]) // Composite: date range availability
  @@index([platform, status]) // Filter by platform and status
  @@index([platform]) // Filter by booking source
  @@index([createdAt]) // Sort by creation date
  @@index([confirmCode]) // Lookup by confirmation code
  @@unique([platform, externalRef]) // Channel webhook idempotency -- see externalRef
}

/// Work queued for the Tuya access lifecycle by a channel webhook.
///
/// Replaces the `access_lifecycle_queue` Firestore collection, which keyed
/// documents on `${bookingId}_${action}` and merged -- so re-delivering the same
/// webhook could never enqueue the same work twice. `@@unique([bookingRef,
/// action])` preserves exactly that property.
///
/// `containsCredential` is deliberately kept and deliberately always false: the
/// webhook never generates, stores or transports door codes, and the column
/// makes that contract explicit to anything reading the queue rather than
/// leaving it as a comment in one route.
model AccessLifecycleQueue {
  id         String   @id @default(cuid())
  /// The CHANNEL's reservation id, not Booking.id -- the queue is written from
  /// the webhook and is meaningful even if the booking row is rejected.
  bookingRef String
  propertyId String?
  /// PROVISION | RESCHEDULE | REVOKE
  action     String
  status     String   @default("PENDING_VERIFICATION")
  containsCredential Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bookingRef, action])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// CLEANING & CREW
// ============================================

model CleaningJob {
  id         String  @id @default(cuid())
  propertyId String
  cleanerId  String?
  bookingId  String? @unique

  // Scheduling
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?

  // Type
  jobType String @default("TURNOVER")

  // Status
  status String @default("SCHEDULED")

  // GPS Verification
  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?

  // Checklist & Photos (stored as JSON string)
  checklistProgress String?
  photos            String?

  // Quality
  score         Int?
  scoreFeedback String?

  // Notes
  notes  String?
  issues String?

  // Duration
  durationMins Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id])
  cleaner  User?    @relation(fields: [cleanerId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  // Performance indexes
  @@index([propertyId])
  @@index([cleanerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([propertyId, scheduledAt]) // Composite: property cleaning schedule
  @@index([cleanerId, status]) // Composite: cleaner's active jobs
  @@index([cleanerId, scheduledAt]) // Composite: cleaner's schedule
  @@index([scheduledAt, status]) // Composite: upcoming jobs by status
  @@index([jobType, status]) // Filter by job type and status
  @@index([createdAt]) // Sort by creation date
  @@index([completedAt]) // Query completed jobs
}

// ============================================
// SMART LOCKS
// ============================================

model SmartLock {
  id         String @id @default(cuid())
  propertyId String @unique

  // Device Info
  brand        String
  model        String?
  deviceId     String
  serialNumber String?

  // Current State
  currentCode   String?
  codeExpiresAt DateTime?
  batteryLevel  Int?
  lastActivity  DateTime?
  isOnline      Boolean   @default(true)

  // Access Log (stored as JSON string)
  accessLog String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id])

  @@index([brand])
}

// ============================================
// MESSAGING
// ============================================

model Message {
  id        String  @id @default(cuid())
  guestId   String
  bookingId String?

  // Message Details
  type    String
  channel String  @default("EMAIL")
  subject String?
  body    String

  // Status
  status String @default("DRAFT")

  // Scheduling
  scheduledFor DateTime?
  sentAt       DateTime?

  // Approval
  approvedBy String?
  approvedAt DateTime?

  // AI Analysis
  sentiment      String?
  sentimentScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guest    Guest    @relation(fields: [guestId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])
  approver User?    @relation("ApprovedBy", fields: [approvedBy], references: [id])

  // Performance indexes
  @@index([guestId])
  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@index([channel]) // Filter by message channel
  @@index([guestId, type]) // Composite: guest messages by type
  @@index([status, scheduledFor]) // Composite: scheduled messages queue
  @@index([sentAt]) // Query sent messages
  @@index([createdAt]) // Sort by creation date
  @@index([sentiment]) // Filter by sentiment analysis
}

// ============================================
// FINANCES
// ============================================

model Expense {
  id          String  @id @default(cuid())
  propertyId  String?
  createdById String?

  // Expense Details
  category    String
  subcategory String?
  amount      Float
  description String
  vendor      String?

  // Date
  date DateTime

  // Receipt
  receiptUrl String?

  // Tax
  isTaxDeductible Boolean @default(true)
  taxCategory     String?

  // Status
  status String @default("PENDING")

  // Payment
  paymentMethod String?

  /// The stay this cost belongs to, when it is attributable to one.
  bookingId String?
  /// A recurring cost (subscription, utility) rather than a one-off.
  recurring Boolean @default(false)

  // Notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property  Property? @relation(fields: [propertyId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  // Performance indexes
  @@index([propertyId])
  @@index([category])
  @@index([date])
  @@index([propertyId, date]) // Composite: property expenses by date
  @@index([propertyId, category]) // Composite: property expenses by category
  @@index([category, date]) // Composite: expenses report
  @@index([status]) // Filter by approval status
  @@index([isTaxDeductible]) // Filter for tax reports
  @@index([isTaxDeductible, taxCategory]) // Composite: tax category reports
  @@index([vendor]) // Group by vendor
  @@index([createdAt]) // Sort by creation date
}

// ============================================
// AI CONCIERGE
// ============================================

model ConciergeQuery {
  id         String  @id @default(cuid())
  guestId    String?
  propertyId String?

  // Query & Response
  query    String
  response String

  // Classification
  category String?
  intent   String?

  // Quality
  wasHelpful Boolean?
  rating     Int?

  // Voice
  voiceUsed Boolean @default(false)
  audioUrl  String?

  createdAt DateTime @default(now())

  // Relations
  guest Guest? @relation(fields: [guestId], references: [id])

  @@index([guestId])
  @@index([category])
  @@index([createdAt])
}

// ============================================
// SYSTEM & AUDIT
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues String?
  newValues String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Performance indexes
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@index([entity, entityId]) // Composite: lookup entity history
  @@index([action]) // Filter by action type
  @@index([userId, createdAt]) // Composite: user activity history
  @@index([entity, action]) // Composite: entity action reports
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ============================================
// VRBO DIRECT INTEGRATION (No PMS needed)
// ============================================

model VrboSync {
  id             String    @id @default(cuid())
  propertyId     String
  vrboListingId  String
  icalUrl        String?
  lastIcalSync   DateTime?
  lastScrapeSync DateTime?
  syncEnabled    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId])
  @@unique([vrboListingId])
  @@index([syncEnabled])
}

model SyncLog {
  id             String   @id @default(cuid())
  propertyId     String?
  syncType       String // ical_import, ical_export, scrape_bookings, scrape_messages, rate_push
  source         String // vrbo, airbnb, booking
  status         String // success, partial, failed
  itemsProcessed Int      @default(0)
  itemsCreated   Int      @default(0)
  itemsUpdated   Int      @default(0)
  errorMessage   String?
  durationMs     Int?
  metadata       String?
  createdAt      DateTime @default(now())

  @@index([propertyId, createdAt])
  @@index([syncType, createdAt])
  @@index([status])
}

// ============================================
// OPERATIONS, DISPATCH, ACCESS & PAY
// ============================================

model WorkerProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  workerType            String
  /// Which cleaning crew this worker belongs to ("A" / "B").
  ///
  /// The P0 acceptance matrix froze Crew A and Crew B as a requirement and the
  /// schema had NO crew concept at all -- only a `// CLEANING & CREW` section
  /// comment. Scheduling, dispatch and the turnover workflows all talk about
  /// crews, so the grouping has to exist somewhere other than in people's heads.
  ///
  /// Deliberately a nullable String on WorkerProfile rather than a Crew model:
  /// there are two crews and no evidence yet that a crew carries attributes of
  /// its own (a lead, a rate, a schedule). Adding a table for a two-value
  /// grouping would be inventing structure the business has not asked for. If
  /// crews later need their own fields, this promotes to a relation cleanly.
  crew                  String?
  employmentClass       String   @default("EMPLOYEE")
  dispatchPriority      Int      @default(100)
  autoDispatchEligible  Boolean  @default(true)
  defaultPayType        String   @default("PER_JOB")
  hourlyRateCents       Int?
  paymentMethod         String?
  paymentDestinationRef String?
  tuyaIdentityRef       String?
  isAvailable           Boolean  @default(true)
  maxConcurrentJobs     Int      @default(1)
  scheduleJson          String?

  // ---- Employment / HR (added 2026-07-30) --------------------------------
  hireDate              DateTime?
  defaultHours          Int?
  addressLine           String?

  /// LAST FOUR DIGITS ONLY. The full SSN is deliberately NOT stored anywhere in
  /// this system: the only consumer is a masked display, and data you do not
  /// hold cannot be leaked, subpoenaed, or mis-handled. The API layer rejects
  /// any input longer than 4 digits so a full SSN cannot be quietly written
  /// into this column. Owner/admin only, never logged.
  ssnLast4              String?
  w4FilingStatus        String?
  w4Allowances          Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workOrders       WorkOrder[]
  payEntries       WorkerPayEntry[]
  serviceSchedules ServiceSchedule[]

  @@index([workerType, isAvailable])
  @@index([autoDispatchEligible, dispatchPriority])
  @@index([employmentClass])
}

/// One turn of a Steven AI conversation. Replaces the `rah_steven_sessions` and
/// `rah_steven_guests` Firestore collections.
///
/// A "session" is not a row -- it is simply the messages sharing a sessionId.
/// The Firestore version stored a session document holding an array of messages
/// and rewrote the whole array on every turn, trimming to the last 50; that is a
/// read-modify-write on a hot document, and two concurrent turns lose one of
/// their messages. Append-only rows with an index make the trim a query concern
/// instead of a write concern, and concurrent turns cannot clobber each other.
///
/// `guestId` deliberately carries NO foreign key. This is an append-only
/// transcript, and it must never fail to record what was said because the
/// speaker is not (yet) in the CRM. A referential constraint here would turn an
/// unknown guest into a 500 from the assistant endpoint and lose the
/// conversation entirely -- strictly worse than a dangling identifier in a log.
model StevenMessage {
  id         String   @id @default(cuid())
  sessionId  String
  /// Guest.id when the caller supplied one that exists. Not enforced -- see above.
  guestId    String?
  /// 'user' | 'assistant'
  role       String
  content    String
  emotion    String?
  propertyId String?
  createdAt  DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([guestId, createdAt])
  @@index([createdAt])
}

/// A REQUEST to become staff. Deliberately not a role, and deliberately not a
/// WorkerProfile.
///
/// The signup form lets a visitor tick "Staff" and pick cleaner / yard crew /
/// handyman. The old flow wrote that choice straight into the role store and
/// showed a "pending approval" toast, but nothing anywhere enforced the
/// pending part -- and `CLEANER` maps to the `worker` role, so anyone who
/// self-registered as a cleaner held worker permissions on every route guarded
/// by `requireRole(request, 'worker')` from the moment they submitted the form.
///
/// Splitting the request from the grant is what makes "pending" real: this row
/// records what somebody asked for and confers nothing. An owner or admin
/// provisions `User.role` and the `WorkerProfile` separately, which is the only
/// path that grants anything.
model StaffApplication {
  id            String   @id @default(cuid())
  userId        String
  /// What the applicant asked to be: cleaner | yard_crew | handyman. Stored as
  /// submitted rather than mapped to a role, precisely so that reading this
  /// column can never be mistaken for reading an authorization.
  requestedType String
  status        String   @default("PENDING")
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model PropertyServiceRate {
  id            String    @id @default(cuid())
  propertyId    String
  serviceType   String
  amountCents   Int
  currency      String    @default("USD")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, serviceType, effectiveFrom])
  @@index([propertyId, serviceType, isActive])
}

model PropertyChecklistTemplate {
  id          String   @id @default(cuid())
  propertyId  String
  serviceType String
  name        String
  version     Int      @default(1)
  itemsJson   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, serviceType, version])
  @@index([propertyId, serviceType, isActive])
}

model WorkOrder {
  id                String    @id @default(cuid())
  propertyId        String
  bookingId         String?
  requestedByUserId String?
  assignedWorkerId  String?
  serviceType       String
  source            String    @default("SYSTEM")
  status            String    @default("PENDING")
  dispatchMode      String    @default("MANUAL")
  priority          Int       @default(50)
  title             String
  description       String?
  scheduledStart    DateTime?
  dueAt             DateTime?
  acceptedAt        DateTime?
  checkedInAt       DateTime?
  completedAt       DateTime?
  checkedOutAt      DateTime?
  checkInLat        Float?
  checkInLng        Float?
  checkOutLat       Float?
  checkOutLng       Float?
  timerSeconds      Int?
  payAmountCents    Int?
  paymentStatus     String    @default("UNAPPROVED")
  reportSummary     String?
  damageReported    Boolean   @default(false)
  theftReported     Boolean   @default(false)
  maintenanceNeeded Boolean   @default(false)
  yardNeeded        Boolean   @default(false)
  poolNeeded        Boolean   @default(false)
  reportSubmittedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  property       Property                 @relation(fields: [propertyId], references: [id])
  booking        Booking?                 @relation(fields: [bookingId], references: [id])
  requestedBy    User?                    @relation("WorkOrderRequestedBy", fields: [requestedByUserId], references: [id])
  assignedWorker WorkerProfile?           @relation(fields: [assignedWorkerId], references: [id])
  checklistItems WorkOrderChecklistItem[]
  photos         WorkOrderPhoto[]
  issues         WorkOrderIssue[]
  payEntry       WorkerPayEntry?
  accessGrant    AccessGrant?
  guestRequests  GuestRequest[]
  alerts         OperationalAlert[]

  @@index([propertyId, status])
  @@index([bookingId])
  @@index([assignedWorkerId, status])
  @@index([serviceType, status])
  @@index([scheduledStart])
  @@index([dueAt, status])
  @@index([dispatchMode, status, priority])
}

model WorkOrderChecklistItem {
