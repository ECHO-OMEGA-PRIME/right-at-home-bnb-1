model PayrollBatch {
  id            String    @id @default(cuid())
  /// Holds the pay-period END date. The historical name says "week" but runs
  /// may be semi-monthly; the @unique is KEPT deliberately -- it is what stops
  /// payroll being run twice for the same period, which is a real hazard.
  weekEnding    DateTime  @unique
  periodStart   DateTime?
  payDate       DateTime?
  status        String    @default("DRAFT")
  totalCents    Int       @default(0)
  /// Run totals. totalCents remains the net payable; these break it down.
  totalGrossCents       Int @default(0)
  totalNetCents         Int @default(0)
  totalEmployerTaxCents Int @default(0)
  paymentMethod String?
  /// Set once the run is approved/processed and its journal entry is posted.
  /// Presence of this is what makes approval idempotent: a second approve
  /// cannot double-post payroll into the ledger.
  journalEntryId String?
  approvedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entries WorkerPayEntry[]

  @@index([status, weekEnding])
}

model WorkerPayEntry {
  id                 String    @id @default(cuid())
  workerId           String
  /// Optional: a payroll-run entry covers a pay PERIOD, not a single job, so it
  /// has no work order. @unique is kept -- Postgres allows many NULLs, so
  /// job-based pay still gets exactly one entry per work order.
  workOrderId        String?   @unique
  payrollBatchId     String?
  /// Gross for the period (or the job amount for work-order pay).
  amountCents        Int

  // ---- Payroll-run breakdown (added 2026-07-30) ------------------------
  hours                 Float?
  federalCents          Int @default(0)
  socialSecurityCents   Int @default(0)
  medicareCents         Int @default(0)
  stateCents            Int @default(0)
  netCents              Int @default(0)
  /// Employer-side contributions -- a cost to the business, not withheld from
  /// the worker. Kept separate so they can never be netted off gross by mistake.
  employerSsCents       Int @default(0)
  employerMedicareCents Int @default(0)
  futaCents             Int @default(0)
  /// State unemployment. Stored, not recomputed on read: a historical run must
  /// retain the rate that was actually applied when it was processed.
  sutaCents             Int @default(0)
  currency           String    @default("USD")
  status             String    @default("EARNED")
  earnedAt           DateTime  @default(now())
  approvedAt         DateTime?
  paidAt             DateTime?
  paymentMethod      String?
  externalPaymentRef String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  worker       WorkerProfile @relation(fields: [workerId], references: [id])
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id])
  payrollBatch PayrollBatch? @relation(fields: [payrollBatchId], references: [id])

  @@index([workerId, status, earnedAt])
  @@index([payrollBatchId])
}

model ConciergeAction {
  id                String    @id @default(cuid())
  requestedByUserId String?
  approvedByUserId  String?
  actorType         String
  actionType        String
  targetType        String?
  targetId          String?
  riskLevel         String    @default("LOW")
  requiresApproval  Boolean   @default(false)
  approvalStatus    String    @default("NOT_REQUIRED")
  status            String    @default("QUEUED")
  idempotencyKey    String    @unique
  inputJson         String?
  resultJson        String?
  failureReason     String?
  approvedAt        DateTime?
  executedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requestedBy User? @relation("ConciergeActionRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy  User? @relation("ConciergeActionApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([status, riskLevel])
  @@index([requestedByUserId, createdAt])
  @@index([actionType, targetType, targetId])
}

model OperationalAlert {
  id               String    @id @default(cuid())
  propertyId       String?
  bookingId        String?
  workOrderId      String?
  assignedToUserId String?
  alertType        String
  severity         String    @default("NORMAL")
  title            String
  message          String
  status           String    @default("OPEN")
  notifiedAt       DateTime?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  resolvedBy       String?
  /// Identifies the real-world thing this alert is ABOUT (a cleaning schedule
  /// id, a system check name), so "is there already an open alert for this?"
  /// is one indexed query.
  ///
  /// This is what makes de-duplication possible at all. The Firestore version
  /// kept the same idea as `cleanerScheduleId`, and when that store was
  /// unreachable the lookup returned "no existing alert" -- so every run
  /// re-alerted and phoned a real person every 15 minutes for the length of the
  /// outage. De-duplication that fails open is not de-duplication.
  dedupeKey        String?
  /// Alert-kind-specific detail as JSON (cleaner name, phone, hours late, which
  /// notifications went out). Kept out of columns because the shape differs per
  /// alertType and none of it is queried.
  metadata         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  property   Property?  @relation(fields: [propertyId], references: [id])
  booking    Booking?   @relation(fields: [bookingId], references: [id])
  workOrder  WorkOrder? @relation(fields: [workOrderId], references: [id])
  assignedTo User?      @relation("AlertAssignee", fields: [assignedToUserId], references: [id])

  @@index([status, severity, createdAt])
  @@index([propertyId, status])
  @@index([bookingId])
  @@index([workOrderId])
  @@index([assignedToUserId, status])
  @@index([dedupeKey, status]) // "already an open alert for this thing?"
  @@index([alertType, status])
}

