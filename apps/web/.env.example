# Right at Home BnB - Web environment template
# Copy to .env.local and fill values from the verified production systems.
# Never commit .env.local or service-account JSON.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase client - canonical RAH project
NEXT_PUBLIC_FIREBASE_API_KEY=<copy-from-echo-prime-ai-project-settings>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=echo-prime-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=echo-prime-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<copy-exact-bucket-from-firebase-console>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<copy-from-echo-prime-ai-project-settings>
NEXT_PUBLIC_FIREBASE_APP_ID=<copy-from-echo-prime-ai-project-settings>

# Firebase Admin - server only
FIREBASE_PROJECT_ID=echo-prime-ai
FIREBASE_STORAGE_BUCKET=<copy-exact-bucket-from-firebase-console>
FIREBASE_SERVICE_ACCOUNT=<single-line-json-for-echo-prime-ai-service-account>

# Database
DATABASE_URL=<postgres-connection-string>
DIRECT_URL=<direct-postgres-connection-string>

# Integrations
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_PHONE_NUMBER=<twilio-phone-number>
TUYA_ACCESS_ID=<tuya-access-id>
TUYA_ACCESS_SECRET=<tuya-access-secret>
GROQ_API_KEY=<groq-api-key>
ELEVENLABS_API_KEY=<elevenlabs-api-key>
ELEVENLABS_STEVEN_VOICE_ID=<elevenlabs-voice-id>

# Development-only authentication must remain disabled in production
ALLOW_DEV_LOGIN=false
NEXT_PUBLIC_ALLOW_DEV_LOGIN=false
