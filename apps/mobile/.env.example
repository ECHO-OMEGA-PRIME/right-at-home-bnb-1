# Right at Home BnB - Mobile Environment Variables
# Copy to a local ignored .env file and populate from the approved secret store.

# API
EXPO_PUBLIC_API_URL=https://api.rah-midland.com

# Firebase - canonical RAH project only.
# The real, controlled project is echo-prime-ai (per ECHO doctrine "ALL sites
# use ONE project echo-prime-ai"). The retired project is NOT ours; using it was
# the exact cause of the P0 login outage on web, fixed in apps/web/src/lib/
# firebase-client-config.ts (commit c442be3) and mirrored here.
EXPO_PUBLIC_FIREBASE_API_KEY=replace_with_echo_prime_ai_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=echo-prime-ai.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=echo-prime-ai
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=echo-prime-ai.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_echo_prime_ai_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=replace_with_echo_prime_ai_mobile_app_id

# Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace_with_verified_google_web_client_id

# Push Notifications
EXPO_PUBLIC_EAS_PROJECT_ID=replace_with_verified_eas_project_id

# Google Maps (used by app.config.js, NOT prefixed EXPO_PUBLIC_ -- these are
# build-time only, read by Expo config, and must be set via `eas secret:create`
# for CI/EAS builds, not bundled into the client).
GOOGLE_MAPS_API_KEY_IOS=replace_with_ios_google_maps_api_key
GOOGLE_MAPS_API_KEY_ANDROID=replace_with_android_google_maps_api_key
