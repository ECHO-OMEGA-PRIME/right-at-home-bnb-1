# Right at Home BnB - Backend Environment Variables
# Copy to an ignored local environment file and populate from the approved secret store.

# Database
DATABASE_URL=replace_with_postgresql_connection_string
DATABASE_POOL_SIZE=10

# Authentication
JWT_SECRET=replace_with_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_SECRET_KEY=replace_with_random_service_secret

# Firebase - canonical RAH project only (echo-prime-ai; see EXPECTED_FIREBASE_PROJECT_ID in routers/photos.py)
FIREBASE_PROJECT_ID=echo-prime-ai
FIREBASE_STORAGE_BUCKET=echo-prime-ai.appspot.com
FIREBASE_SERVICE_ACCOUNT=replace_with_single_line_echo_prime_ai_service_account_json
GOOGLE_APPLICATION_CREDENTIALS=

# AI and voice
OPENAI_API_KEY=
OPENAI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Smart-lock providers
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
SCHLAGE_API_KEY=
YALE_API_KEY=
AUGUST_API_KEY=

# Communications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CORS
CORS_ORIGINS=https://rah-midland.com,https://www.rah-midland.com

# Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
