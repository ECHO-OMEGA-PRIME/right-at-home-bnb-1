# Right at Home BnB - Environment Configuration
# Copy to a local environment file and populate values from verified systems.
# Never commit runtime environment files or private-key material.

# ============================================
# DATABASE
# ============================================
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET="CHANGE_ME_generate_at_least_32_random_characters"
API_SECRET_KEY="CHANGE_ME_generate_at_least_32_random_characters"
SESSION_SECRET="CHANGE_ME_generate_at_least_32_random_characters"
SESSION_TIMEOUT="86400"
ALLOW_DEV_LOGIN="false"
NEXT_PUBLIC_ALLOW_DEV_LOGIN="false"

# ============================================
# FIREBASE — CANONICAL RAH PROJECT ONLY
# ============================================
FIREBASE_PROJECT_ID="echo-prime-ai"
FIREBASE_STORAGE_BUCKET="<copy-exact-bucket-from-firebase-console>"
FIREBASE_SERVICE_ACCOUNT="<single-line-json-for-echo-prime-ai-service-account>"

NEXT_PUBLIC_FIREBASE_API_KEY="<copy-from-echo-prime-ai-project-settings>"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="echo-prime-ai.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="echo-prime-ai"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="<copy-exact-bucket-from-firebase-console>"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="<copy-from-echo-prime-ai-project-settings>"
NEXT_PUBLIC_FIREBASE_APP_ID="<copy-from-echo-prime-ai-project-settings>"

# ============================================
# APPLICATION / API
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"
ECHO_API_BASE="https://api.rah-midland.com"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
NODE_ENV="development"

# ============================================
# AI SERVICES
# ============================================
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_STEVEN_VOICE_ID=""

# ============================================
# ECHO SDK GATE + LLM
# ============================================
ECHO_SDK_GATE="https://sdk1.echo-op.com"
ECHO_SOVEREIGN_KEY=""
LLM_CAP="echo.claude.oauth"
LLM_MODEL="claude-haiku-4-5-20251001"

# ============================================
# SMART LOCKS
# ============================================
SCHLAGE_API_KEY=""
SCHLAGE_API_SECRET=""
YALE_API_KEY=""
AUGUST_API_KEY=""
TUYA_ACCESS_KEY=""
TUYA_SECRET_KEY=""
TUYA_BASE_URL="https://openapi.tuyaus.com"
TUYA_LOCK_GARFIELD=""
TUYA_LOCK_CASTLEFORD=""
TUYA_LOCK_LINCOLN_GREEN=""

# ============================================
# COMMUNICATIONS / MAPS
# ============================================
GOOGLE_MAPS_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# ============================================
# PAYMENTS
# ============================================
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# ============================================
# STORAGE — MINIO
# ============================================
MINIO_ENDPOINT="http://192.168.1.96:9000"
MINIO_BUCKET="rah-uploads"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_REGION="us-east-1"

# ============================================
# CHANNEL MANAGER / PMS
# ============================================
OWNERREZ_EMAIL=""
OWNERREZ_API_TOKEN=""

# ============================================
# DEPLOYMENT
# ============================================
VERCEL_TOKEN=""
GCP_PROJECT_ID="<verified-deployment-project-id>"
GCP_REGION="us-central1"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_API="100"
RATE_LIMIT_AUTH="5"

# ============================================
# VRBO MAILBRIDGE — READ-ONLY SHADOW MODE
# ============================================
VRBO_MAIL_SHADOW_MODE="true"
VRBO_MAIL_IMAP_HOST="imap.mail.att.net"
VRBO_MAIL_IMAP_PORT="993"
VRBO_MAIL_USERNAME=""
VRBO_MAIL_PASSWORD_FILE=""
VRBO_MAIL_PASSWORD=""
VRBO_MAIL_MAILBOX="INBOX"
VRBO_MAIL_ALLOWED_SENDER_DOMAINS="vrbo.com,homeaway.com,expediagroup.com"
VRBO_MAIL_SUBJECT_MARKERS="vrbo,reservation,booking,inquiry,traveler"
VRBO_MAIL_MAX_MESSAGES="250"
VRBO_ICAL_ALLOWED_DOMAINS="vrbo.com,homeaway.com"
VRBO_ICAL_MAX_BYTES="5242880"
VRBO_ICAL_TIMEOUT_SECONDS="30"
