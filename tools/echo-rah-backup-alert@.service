[Unit]
Description=Alert for failed RAH verified backup unit %i
Documentation=file:/opt/rah-backup-verify/current/BACKUP_VERIFY.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=forge
Group=forge
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/rah-backup-alert.env
ExecStart=/usr/bin/python3 /opt/rah-backup-verify/current/backup_watchdog.py failure %i
StandardInput=null
StandardOutput=journal
StandardError=journal
StateDirectory=rah-backup-monitor
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=90
MemoryMax=128M
Nice=10
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
